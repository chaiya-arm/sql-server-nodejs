{
  "info": {
    "name": "api-node (Express + Sequelize)",
    "description": "Collection ทดสอบ api-node ครบทุก endpoint รวมตัวอย่างความสัมพันธ์ ORM 4 แบบ\n\nตัวแปร (Variables):\n- baseUrl : http://localhost:3000\n- apiKey  : คีย์จาก .env (prefill ให้แล้ว)\n- token   : JWT ที่ได้จาก login (auto-save อัตโนมัติหลังยิง Auth > login)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "apiKey", "value": "f2c6cd3057a71fd92c5a0dfb83fa0682aa255c78bbc48670c5c4cb41c144c7d4", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET / (health check)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] } }
        }
      ]
    },
    {
      "name": "Public (ใช้ได้เลย)",
      "item": [
        {
          "name": "GET /public/ping",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/public/ping", "host": ["{{baseUrl}}"], "path": ["public", "ping"] } }
        },
        {
          "name": "GET /public/info",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/public/info", "host": ["{{baseUrl}}"], "path": ["public", "info"] } }
        }
      ]
    },
    {
      "name": "Protected (ต้องมี API Key)",
      "item": [
        {
          "name": "GET /api/secret (มีคีย์)",
          "request": {
            "method": "GET",
            "header": [ { "key": "x-api-key", "value": "{{apiKey}}" } ],
            "url": { "raw": "{{baseUrl}}/api/secret", "host": ["{{baseUrl}}"], "path": ["api", "secret"] }
          }
        },
        {
          "name": "GET /api/whoami (มีคีย์)",
          "request": {
            "method": "GET",
            "header": [ { "key": "x-api-key", "value": "{{apiKey}}" } ],
            "url": { "raw": "{{baseUrl}}/api/whoami", "host": ["{{baseUrl}}"], "path": ["api", "whoami"] }
          }
        },
        {
          "name": "GET /api/secret (ไม่มีคีย์ -> 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/secret", "host": ["{{baseUrl}}"], "path": ["api", "secret"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"somchai\",\n  \"password\": \"1234\",\n  \"fullname\": \"สมชาย ใจดี\",\n  \"email\": \"s@mail.com\",\n  \"phone\": \"0812345678\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "POST /auth/login (auto-save token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  console.log('saved token:', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"somchai\",\n  \"password\": \"1234\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "GET /auth/me (ใช้ token)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "GET /products",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] } }
        },
        {
          "name": "GET /products/:id (+ images)",
