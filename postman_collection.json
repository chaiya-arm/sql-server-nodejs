        },
        {
          "name": "POST /products",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"สินค้า A\",\n  \"price\": 150,\n  \"stock\": 10,\n  \"status\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "PUT /products/:id",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 199\n}" },
            "url": { "raw": "{{baseUrl}}/products/1", "host": ["{{baseUrl}}"], "path": ["products", "1"] }
          }
        },
        {
          "name": "DELETE /products/:id",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/products/1", "host": ["{{baseUrl}}"], "path": ["products", "1"] } }
        },
        {
          "name": "GET /products/:id/images",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/products/1/images", "host": ["{{baseUrl}}"], "path": ["products", "1", "images"] } }
        },
        {
          "name": "POST /products/:id/image (1 รูป)",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [ { "key": "image", "type": "file", "src": [] } ] },
            "url": { "raw": "{{baseUrl}}/products/1/image", "host": ["{{baseUrl}}"], "path": ["products", "1", "image"] }
          }
        },
        {
          "name": "POST /products/:id/images (หลายรูป)",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [ { "key": "images", "type": "file", "src": [] }, { "key": "images", "type": "file", "src": [] } ] },
            "url": { "raw": "{{baseUrl}}/products/1/images", "host": ["{{baseUrl}}"], "path": ["products", "1", "images"] }
          }
        },
        {
          "name": "PUT /products/:id/images/:imageId",
          "request": {
            "method": "PUT",
            "header": [],
            "body": { "mode": "formdata", "formdata": [ { "key": "image", "type": "file", "src": [] } ] },
            "url": { "raw": "{{baseUrl}}/products/1/images/1", "host": ["{{baseUrl}}"], "path": ["products", "1", "images", "1"] }
          }
        },
        {
          "name": "DELETE /products/:id/images/:imageId",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/products/1/images/1", "host": ["{{baseUrl}}"], "path": ["products", "1", "images", "1"] } }
        }
      ]
    },
