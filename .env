DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=Armmy094
DB_DATABASE=ruay_shop

# พอร์ตที่ server รัน
PORT=3000

# CORS: รายชื่อ origin ที่อนุญาต (คั่นด้วย comma) — เว้นว่าง = อนุญาตทุก origin
# ตัวอย่าง: ALLOWED_ORIGINS=https://myapp.com,http://localhost:5173
ALLOWED_ORIGINS=

# กุญแจลับสำหรับเซ็น JWT (โปรดเปลี่ยนเป็นค่าสุ่มยาว ๆ ในระบบจริง)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=44facee3d3fd1c287dbe9534c65f1420b0f2ab6e0822312358abd4a85f2167c8
JWT_EXPIRES_IN=1d
# ┌─────┬────────────────────────────┐
# │ ค่า  │          ความหมาย          │
# ├─────┼────────────────────────────┤
# │ 60  │ 60 วินาที (ตัวเลขเปล่า = วินาที) │
# ├─────┼────────────────────────────┤
# │ 30m │ 30 นาที                     │
# ├─────┼────────────────────────────┤
# │ 12h │ 12 ชั่วโมง                   │
# ├─────┼────────────────────────────┤
# │ 1d  │ 1 วัน ← ตอนนี้                │
# ├─────┼────────────────────────────┤
# │ 7d  │ 7 วัน                       │
# ├─────┼────────────────────────────┤
# │ 30d │ 30 วัน

# API Key สำหรับ route กลุ่ม protected (ส่งมาใน header x-api-key)
API_KEY=f2c6cd3057a71fd92c5a0dfb83fa0682aa255c78bbc48670c5c4cb41c144c7d4


# ┌─────────────┬────────────────────────────────────┬────────────────────────────────────┐
# │             │        API Key (x-api-key)         │ Token (JWT, Authorization: Bearer) │
# ├─────────────┼────────────────────────────────────┼────────────────────────────────────┤
# │ คืออะไร      │ กุญแจของตัวแอป/ระบบ                  │ บัตรของผู้ใช้ที่ login แล้ว               │
# ├─────────────┼────────────────────────────────────┼────────────────────────────────────┤
# │ ได้มาตอนไหน  │ ตั้งไว้คงที่ใน .env                     │ ได้ตอน login สำเร็จ                  │
# ├─────────────┼────────────────────────────────────┼────────────────────────────────────┤
# │ เปลี่ยนไหม    │ ไม่เปลี่ยน (จนกว่าจะตั้งใหม่)             │ หมดอายุตาม 1d แล้วขอใหม่              │
# ├─────────────┼────────────────────────────────────┼────────────────────────────────────┤
# │ ต้องส่งตอนไหน │ ทุก request ของ route กลุ่ม protected │ ทุก request ที่ต้องรู้ว่าเป็นใคร           │
# └─────────────┴────────────────────────────────────┴────────────────────────────────────┘