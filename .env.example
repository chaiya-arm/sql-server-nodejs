# .env.example — คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องคุณ
#   คำสั่งช่วย:  node cli env:init      (คัดลอก .env.example -> .env)
#              node cli key:generate  (สุ่ม JWT_SECRET + API_KEY ใส่ .env ให้)

# ===== ฐานข้อมูล MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=test-node

# ===== พอร์ตที่ server รัน =====
PORT=3000

# ===== CORS =====
# รายชื่อ origin ที่อนุญาตให้เรียก API (คั่นด้วย comma, ไม่ต้องมี / ปิดท้าย)
# ถ้าเว้นว่าง = อนุญาตทุก origin (เหมาะช่วงพัฒนาเท่านั้น)
# ตัวอย่าง: ALLOWED_ORIGINS=https://myapp.com,http://localhost:5173
ALLOWED_ORIGINS=

# ===== JWT (กุญแจเซ็น token ของผู้ใช้ที่ login) =====
# ห้ามใช้ค่าตัวอย่างนี้ในระบบจริง — รัน `node cli key:generate` เพื่อสุ่มใหม่
JWT_SECRET=CHANGE_ME_ใช้_node_cli_key:generate
JWT_EXPIRES_IN=1d

# ===== API Key (กุญแจของระบบ สำหรับ route กลุ่ม protected, ส่งใน header x-api-key) =====
API_KEY=CHANGE_ME_ใช้_node_cli_key:generate

# ===== SMTP (ส่งอีเมลด้วย nodemailer — helpers/Mailer.js) =====
# ถ้าไม่ตั้งค่า SMTP_HOST ระบบจะเป็น "โหมดจำลอง" (ไม่ส่งจริง แค่ log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
