// routes/auth.js
// กลุ่ม "ไม่ต้องใช้ API Key" — สมัคร / ล็อกอิน เปิดให้ทุกคน ; ส่วน /me ต้องแนบ JWT token

const express = require('express');
const router = express.Router();

const AuthController = require('../controllers/AuthController');
const validate = require('../middlewares/ValidateMiddleware');   // เช็ค field ครบ
const auth = require('../middlewares/AuthMiddleware');            // เช็ค token

// สมัครสมาชิก — ต้องมี username, password
router.post('/register', validate(['username', 'password']), AuthController.register);

// เข้าสู่ระบบ — ต้องมี username, password
router.post('/login', validate(['username', 'password']), AuthController.login);

// ดูข้อมูลตัวเอง — ต้องมี token
router.get('/me', auth, AuthController.me);

module.exports = router;
